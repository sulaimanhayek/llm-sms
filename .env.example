# Copy this file to .env and fill it in. Never commit .env.

# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# https://console.twilio.com -> Account info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Twilio number people text, in international format, e.g. +447700900123
TWILIO_NUMBER=

# The public https address of this server (your ngrok URL), no trailing slash
PUBLIC_URL=
